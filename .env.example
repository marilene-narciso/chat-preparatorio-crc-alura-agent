# Copie este arquivo para ".env" e preencha com sua chave real.
# O ".env" nunca deve ser enviado ao GitHub (ele já está no .gitignore).

# Chave da API do Gemini (obtida em https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelo do Gemini a ser usado (opcional, tem um valor padrão no código)
GEMINI_MODEL=gemini-flash-latest
